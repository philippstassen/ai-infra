tenancy_ocid     = "ocid1.tenancy.oc1..insert_tenancy_ocid"
user_ocid        = "ocid1.user.oc1..insert_user_ocid"
fingerprint      = "insert_fingerprint"
private_key_path = "~/.oci/oci_api_key.pem"
region           = "eu-frankfurt-1"
compartment_ocid = "ocid1.compartment.oc1..insert_compartment_ocid"

# Leave null to use the first availability domain in the region.
availability_domain = null

ssh_public_key   = "insert_public_key"
ssh_allowed_cidr = "0.0.0.0/0"
allow_tailscale_udp = false

instance_display_name   = "ai-infra-a1"
vcn_cidr                = "10.42.0.0/16"
subnet_cidr             = "10.42.1.0/24"
shape                   = "VM.Standard.A1.Flex"
ocpus                   = 4
memory_in_gbs           = 24
boot_volume_size_in_gbs = 200
