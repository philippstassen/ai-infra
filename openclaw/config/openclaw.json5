{
  gateway: {
    mode: "local",
    bind: "lan",
    auth: {
      mode: "token",
      token: "${OPENCLAW_GATEWAY_TOKEN}",
    },
  },
  models: {
    providers: {
      // AWS recommends the bedrock-mantle endpoint for Kimi/Qwen/GLM when possible.
      // Keep these explicit so OpenClaw is not blocked by /v1/models discovery.
      "amazon-bedrock-mantle": {
        baseUrl: "https://bedrock-mantle.${AWS_REGION}.api.aws/v1",
        api: "openai-completions",
        auth: "api-key",
        apiKey: "env:AWS_BEARER_TOKEN_BEDROCK",
        models: [
          {
            id: "moonshotai.kimi-k2.5",
            name: "Kimi K2.5",
            reasoning: false,
            input: ["text", "image"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 256000,
            maxTokens: 16000,
          },
          {
            id: "qwen.qwen3-coder-next",
            name: "Qwen3 Coder Next",
            reasoning: false,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 256000,
            maxTokens: 16000,
          },
          {
            id: "zai.glm-4.7",
            name: "GLM 4.7",
            reasoning: false,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 203000,
            maxTokens: 4000,
          },
        ],
      },
      "amazon-bedrock": {
        baseUrl: "https://bedrock-runtime.${AWS_REGION}.amazonaws.com",
        api: "bedrock-converse-stream",
        auth: "aws-sdk",
        models: [
          {
            id: "moonshotai.kimi-k2.5",
            name: "Kimi K2.5",
            reasoning: false,
            input: ["text", "image"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 256000,
            maxTokens: 16000,
          },
          {
            id: "qwen.qwen3-coder-next",
            name: "Qwen3 Coder Next",
            reasoning: false,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 256000,
            maxTokens: 16000,
          },
          {
            id: "zai.glm-4.7",
            name: "GLM 4.7",
            reasoning: false,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 203000,
            maxTokens: 4000,
          },
        ],
      },
    },
  },
  // Keep defaults modest. Add model/provider auth only after first boot works.
  agents: {
    defaults: {
      skipBootstrap: true,
      contextInjection: "continuation-skip",
      workspace: "/var/lib/openclaw/agents/scratch/workspace",
      // Kimi/Qwen/GLM via the AWS Bedrock Mantle catalog.
      model: {
        primary: "amazon-bedrock-mantle/moonshotai.kimi-k2.5",
      },
    },
    list: [
      {
        id: "scratch",
        default: true,
        name: "Scratch",
        workspace: "/var/lib/openclaw/agents/scratch/workspace",
        agentDir: "/var/lib/openclaw/agents/scratch/agent",
      },
      {
        id: "carshare",
        name: "Carshare",
        workspace: "/var/lib/openclaw/agents/carshare/workspace",
        agentDir: "/var/lib/openclaw/agents/carshare/agent",
        tools: {
          allow: ["exec", "read", "session_status"],
          deny: ["write", "edit", "apply_patch", "browser", "canvas", "cron"],
        },
      },
    ],
  },

  session: {
    scope: "per-sender",
    dmScope: "main",
  },

  tools: {
    profile: "coding",
    agentToAgent: {
      enabled: false,
      allow: ["scratch", "carshare"],
    },
  },

  messages: {
    groupChat: {
      mentionPatterns: ["@openclaw", "@carshare"],
    },
  },

  bindings: [
    {
      agentId: "carshare",
      match: {
        channel: "telegram",
        accountId: "default",
        peer: { kind: "group", id: "${TELEGRAM_CARSHARE_GROUP_ID}" },
      },
    },

    // Fallback for direct chats and early testing.
    { agentId: "scratch", match: { channel: "telegram", accountId: "default" } },
    { agentId: "scratch", match: { channel: "discord", accountId: "default" } },
    { agentId: "scratch", match: { channel: "whatsapp", accountId: "default" } },
  ],

  channels: {
    telegram: {
      enabled: true,
      defaultAccount: "default",
      accounts: {
        default: {
          enabled: true,
          botToken: "${TELEGRAM_BOT_TOKEN}",
          dmPolicy: "allowlist",
          allowFrom: ["tg:${TELEGRAM_USER_ID}"],
          groups: {
            "*": { requireMention: true },
          },
        },
      },
    },

    discord: {
      enabled: false,
      defaultAccount: "default",
      groupPolicy: "allowlist",
      accounts: {
        default: {
          enabled: false,
          token: "replace-with-real-discord-bot-token",
          dmPolicy: "pairing",
          guilds: {
            "REPLACE_WITH_GUILD_ID": {
              requireMention: true,
              users: ["REPLACE_WITH_YOUR_USER_ID"],
              channels: {
                "REPLACE_WITH_CHANNEL_ID": {
                  enabled: true,
                  requireMention: true,
                },
              },
            },
          },
        },
      },
    },

    whatsapp: {
      // WhatsApp needs the plugin install and login flow first.
      enabled: false,
      defaultAccount: "default",
      accounts: {
        default: {
          enabled: false,
          dmPolicy: "allowlist",
          allowFrom: ["+15551234567"],
          groupPolicy: "allowlist",
          groupAllowFrom: ["+15551234567"],
          groups: {
            "*": { requireMention: true },
          },
        },
      },
    },
  },

  plugins: {
    entries: {
      "amazon-bedrock": {
        enabled: true,
        config: {
          discovery: {
            enabled: true,
            region: "${AWS_REGION}",
            providerFilter: ["anthropic", "amazon", "moonshotai", "qwen", "zai"],
          },
        },
      },
      "amazon-bedrock-mantle": {
        enabled: true,
      },
    },
  },
}
