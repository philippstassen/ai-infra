POSTGRES_DB=ai_infra
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

ROLE_TOOLING_PASSWORD=change-me-too
ROLE_RUNTIME_PASSWORD=change-me-too
ROLE_READONLY_PASSWORD=change-me-too

CARSHARE_API_PORT=8080
CARSHARE_API_BASE_URL=http://carshare:8080
CARSHARE_DEFAULT_PROJECT=shared-car
CARSHARE_PROJECT_NAME=Shared Car
CARSHARE_CURRENCY=EUR
CARSHARE_BASELINE_PRICE_PER_LITER=1.80

AGENT_RUNTIME_PORT=19080
AGENT_RUNTIME_TELEGRAM_ENABLED=false
AGENT_RUNTIME_ALLOW_IN_MEMORY_STORE=false
AGENT_RUNTIME_DEFAULT_MODEL_ID=moonshotai.kimi-k2.5

BACKUP_KEEP_DAYS=7

# Agent runtime model provider
AWS_REGION=eu-north-1
AWS_DEFAULT_REGION=eu-north-1
AWS_BEARER_TOKEN_BEDROCK=replace-with-bedrock-long-term-api-key

# Telegram
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_USER_ID=replace-with-your-telegram-user-id
TELEGRAM_CARSHARE_GROUP_ID=replace-with-your-telegram-carshare-group-id
