# Local deployment helper config. Copy to `.deploy.env` and adjust locally.
# `.deploy.env` is gitignored because it contains machine-specific access details.

DEPLOY_REMOTE=ubuntu@your-server-ip
DEPLOY_SSH_KEY=~/.ssh/your-server-key
DEPLOY_REMOTE_DIR=/opt/ai-infra
DEPLOY_LOCAL_ENV=.env

# Optional. When true, scripts/update-env.sh recreates the app services after upload.
DEPLOY_RESTART=false
